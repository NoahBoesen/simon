# Generated by Convex. Do not copy the simon-test deployment or database.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Photon 2.0 Beta credentials are used only by the server and Node worker.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Optional enrollment key with platforms:read and platforms:write (server only).
# May use PHOTON_API_KEY instead when it has these scopes.
PHOTON_SETUP_API_KEY=
PHOTON_AGENT_HANDLE=
# Generate with: openssl rand -hex 32
PHOTON_WORKER_SECRET=

# npm run setup adds missing model credentials to the chosen Convex deployment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
FIRECRAWL_API_KEY=

# Optional real test phone. Other demo profiles use reserved example numbers;
# those fictional profiles can only receive mock messages.
DEMO_ATTENDEE_PHONE=

# Phone-accessible app origin used by /qr, e.g. http://192.168.1.20:3000 in dev.
APP_PUBLIC_URL=
