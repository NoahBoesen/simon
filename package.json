{
  "name": "simon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:agent": "tsx watch --env-file=.env.local agent/index.ts",
    "agent": "tsx --env-file=.env.local agent/index.ts",
    "dev:services": "npm run setup && concurrently -k -n web,agent \"npm run dev:web\" \"npm run dev:agent\"",
    "setup": "tsx --env-file=.env.local scripts/setup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:local": "CONVEX_AGENT_MODE=anonymous convex dev --start \"npm run dev:services\"",
    "dev:full": "convex dev --start \"npm run dev:services\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@photon-ai/api": "^0.5.0",
    "convex": "^1.48.0",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.66",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
